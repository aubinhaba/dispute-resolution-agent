# Maven
target/
.mvn/timing.properties
# maven-wrapper.properties IS committed: without it ./mvnw does not know which Maven to fetch,
# so the wrapper is broken for anyone cloning. The wrapper is generated in only-script mode,
# hence no rule for maven-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# OS
.DS_Store
Thumbs.db

# Logs / runtime
*.log

# Secrets — never commit an LLM API key
.env
*.env
application-local.yml
application-local.properties
secrets.properties

# Local Maven settings (machine / internal infra specific — do not commit)
settings-local.xml
scripts/
