<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator parent POM (dra-parent). Two responsibilities only:
    1. Aggregate the child modules so a single `mvn` builds them all.
    2. Centralise versions via <dependencyManagement> (the BOMs).

  Rule: no version in child modules. Children declare WHICH dependencies they want, never WHICH
  version — versions resolve here from the imported BOMs, avoiding two Spring AI versions across modules.

  We IMPORT the Spring Boot BOM (scope=import) instead of inheriting from spring-boot-starter-parent:
  a multi-module project can inherit only one parent, so importing BOMs lets us keep our own
  aggregator parent and stack several BOMs (Spring Boot + Spring AI). Trade-off: we manage plugin
  versions ourselves (see <pluginManagement>).

  Versions (verified against official sources on 2026-06-18, see ADR-0006):
  - Spring Boot 4.1.0  (GA 2026-06-10)
  - Spring AI   2.0.0   (GA 2026-06-12) — requires Spring Boot 4.x, not 3.x.
  - MCP Java SDK 2.0.0  (bundled by the Spring AI BOM)
  Note: "Spring Boot 3 + Spring AI 2.0" is impossible (Spring AI 2.0 targets Spring Framework 7 /
  Boot 4 / Jakarta EE 11).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bino.dra</groupId>
    <artifactId>dra-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Multi-Agent Payment Dispute Resolution System (parent)</name>
    <description>Aggregator parent: centralises versions and modules.</description>

    <modules>
        <module>mcp-payment-server</module>
        <module>dispute-agent</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versions pinned in one place. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <archunit.version>1.3.0</archunit.version>

        <!-- Plugins (otherwise inherited from spring-boot-starter-parent). -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
    </properties>

    <!--
      Imported BOMs. A BOM (Bill of Materials) is a POM containing only version management; importing
      it (scope=import, type=pom) inherits its recommended versions without plugins or dependencies.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM: versions of Spring, Jackson, JUnit, etc. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring AI BOM: ChatClient, Advisors, MCP SDK, vector stores. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ArchUnit: architecture guardrail. Not managed by the BOMs, pinned here. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!-- pluginManagement = centralised plugin versions, applied to children. -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- Surefire: unit tests (*Test) in the `test` phase. Detects JUnit 5 automatically. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- Failsafe: integration tests (*IT) in the `verify` phase. Separates unit/integration. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
