<?xml version="1.0" encoding="UTF-8"?>
<!--
  Read-only MCP tools server (STDIO). Depends on no other module: server and client share a JSON
  contract, not code, so any MCP client can consume it (see ADR-0008). Capability boundary: this module
  carries transactional data; business rules go through RAG on the dispute-agent side (ADR-0001).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bino.dra</groupId>
        <artifactId>dra-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-payment-server</artifactId>
    <name>MCP Payment Server (read-only transactional tools)</name>

    <dependencies>
        <!-- "core" MCP server starter: STDIO transport + @McpTool scanner + MCP Java SDK. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Serializes tool outputs to JSON for the PCI-invariant test. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable fat jar: under STDIO the client launches this jar as a subprocess. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
