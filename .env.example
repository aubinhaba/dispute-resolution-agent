# Copy to .env and fill in. .env is never committed (see .gitignore).
#
# Anthropic key. Without it the containers start and POST /disputes still returns 202, but
# processing ends FAILED: that is the expected behaviour, not a broken install. The async
# contract demonstrates itself without a key.
ANTHROPIC_API_KEY=

# Ports published on the host.
DRA_SERVER_PORT=8080
MCP_SERVER_PORT=8081

# Local Postgres. These values unlock nothing beyond the demo container: the database is not
# published on the host, only the two compose services reach it.
POSTGRES_DB=dra
POSTGRES_USER=dra
POSTGRES_PASSWORD=dra

# Secrets. BOTH are mandatory: left empty, the containers refuse to start, and that is the point
# - a service that opens up because a variable was missing looks protected. The values below run
# the local demo immediately; they protect nothing and are not meant to leave this machine.
#   DRA_API_KEY            protects POST/GET /disputes (public surface).
#   DRA_MCP_SHARED_SECRET  protects /mcp (transactional tools). DISTINCT from the above: losing
#                          one must not hand over the other.
DRA_API_KEY=local-demo-key-change-me
DRA_MCP_SHARED_SECRET=local-demo-secret-change-me
